{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/app.d.ts",
      "default": "./dist/src/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "auth:generate": "auth generate --config src/auth/cli.ts --adapter drizzle --dialect sqlite --output src/db/schema/auth.generated.ts --yes",
    "db:seed": "tsx scripts/seed.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "types:watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@hono/swagger-ui": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@repo/contracts": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.3",
    "hono": "catalog:",
    "hono-telescope": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
