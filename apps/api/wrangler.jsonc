{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-hono-template",
  "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "react-hono-template",
      "database_id": "replace-with-cloudflare-d1-database-id",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "react-hono-template-files",
    },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Daily maintenance (src/maintenance.ts); inherited by every environment.
  "triggers": { "crons": ["17 3 * * *"] },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://app.example.com",
    "EMAIL_MODE": "resend",
    "EMAIL_FROM": "MVP <hello@example.com>",
    "ENABLE_ORGANIZATIONS": "true",
  },
  "observability": {
    "enabled": true,
    // Sampling also drops error logs; lower it only when log volume demands
    // (see docs/cloudflare-free-first.md).
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      // Invocation logs record raw URL paths, which can hold reset tokens; the
      // app logs a redacted "request" event with the route pattern instead.
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "develop": {
      "name": "react-hono-template-develop",
      "routes": [{ "pattern": "develop.example.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "react-hono-template-develop",
          "database_id": "replace-with-develop-d1-database-id",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "react-hono-template-develop-files",
        },
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "EMAIL_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 3, "period": 60 },
        },
        {
          "name": "UPLOAD_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "BETTER_AUTH_URL": "https://develop.example.com",
        "EMAIL_MODE": "resend",
        "EMAIL_FROM": "MVP Develop <develop@example.com>",
        "ENABLE_ORGANIZATIONS": "true",
      },
    },
  },
}
