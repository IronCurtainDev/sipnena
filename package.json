{
  "name": "react-hono-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "pnpm build && turbo run dev types:watch",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "setup:local": "node tools/setup-local.mjs",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "check": "pnpm check:lines && pnpm format:check && pnpm check:schema && pnpm lint:repo && turbo run typecheck lint test build && pnpm openapi:check",
    "security:audit": "pnpm audit --prod --audit-level high",
    "check:lines": "node tools/check-lines.mjs",
    "check:schema": "node tools/check-schema.mjs",
    "deploy:check": "pnpm build && pnpm --filter @repo/api exec wrangler deploy --dry-run --env=\"\"",
    "deploy:env": "pnpm check && node tools/deploy.mjs",
    "openapi:generate": "pnpm --filter @repo/api openapi:generate",
    "openapi:check": "pnpm --filter @repo/api openapi:check",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "lint:repo": "tsc -p tsconfig.json && eslint .",
    "upgrade:hono": "node tools/upgrade-hono.mjs",
    "check:hono": "node tools/upgrade-hono.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.9.1"
  }
}
